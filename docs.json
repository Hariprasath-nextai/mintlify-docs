{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "NextEVI Documentation",
  "colors": {
    "primary": "#d76309",
    "light": "#ea8b39",
    "dark": "#b8520a"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "introduction",
          "quickstart",
          "authentication"
        ]
      },
      {
        "group": "Speech to Speech (EVI)",
        "pages": [
          "speech-to-speech/introduction",
          "speech-to-speech/api-reference",
          "speech-to-speech/react-sdk/installation",
          "speech-to-speech/react-sdk/hooks",
          "speech-to-speech/websocket/protocol",
          "speech-to-speech/features/emotions",
          "speech-to-speech/features/turn-detection",
          "speech-to-speech/examples/simple-chat"
        ]
      },
      {
        "group": "Text-to-Speech",
        "pages": [
          "tts/introduction",
          "tts/getting-started",
          "tts/comparison",
          "tts/engines/orpheus",
          "tts/engines/parler",
          "tts/engines/kokoro",
          "tts/engines/higgs",
          "tts/api/list-models",
          "tts/api/orpheus-generate",
          "tts/api/parler-generate",
          "tts/api/voice-examples"
        ]
      },
      {
        "group": "Integrations",
        "pages": [
          "integrations/javascript",
          "integrations/python",
          "integrations/curl",
          "integrations/examples/simple-tts",
          "integrations/examples/voice-chat",
          "integrations/examples/emotion-analysis"
        ]
      },
      {
        "group": "Core Concepts",
        "pages": [
          "concepts/voice-pipeline",
          "concepts/audio-formats",
          "concepts/error-handling"
        ]
      }
    ]
  },
  "global": {
      "anchors": [
        {
          "anchor": "API Playground",
          "href": "https://app.nextevi.com/dashboard/evi-playground",
          "icon": "play"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/nextevi",
          "icon": "github"
        },
        {
          "anchor": "Support",
          "href": "mailto:support@nextevi.com",
          "icon": "envelope"
        }
      ]
    },
  "logo": {
    "light": "/logo/nextevi-logo.png",
    "dark": "/logo/nextevi-logo.png"
  },
  "navbar": {
    "links": [
      {
        "label": "API Status",
        "href": "https://status.nextevi.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://dashboard.nextevi.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/nextevi",
      "github": "https://github.com/nextevi",
      "linkedin": "https://linkedin.com/company/nextevi"
    }
  }
}

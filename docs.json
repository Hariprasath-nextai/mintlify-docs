{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "NextEVI Documentation",
  "colors": {
    "primary": "#d76309",
    "light": "#ea8b39",
    "dark": "#b8520a"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "introduction",
          "quickstart",
          "authentication"
        ]
      },
      {
        "group": "Speech to Speech (EVI)",
        "pages": [
          "speech-to-speech/introduction",
          "speech-to-speech/react-sdk",
          "speech-to-speech/websocket-api",
          "speech-to-speech/examples"
        ]
      },
      {
        "group": "Text-to-Speech",
        "pages": [
          "tts/getting-started",
          "tts/api-reference"
        ]
      },
      {
        "group": "API Reference",
        "pages": [
          "api-reference/introduction",
          "api-reference/authentication",
          "api-reference/errors"
        ]
      },
      {
        "group": "Examples & Guides",
        "pages": [
          "examples/quick-start",
          "examples/integration-patterns",
          "examples/best-practices"
        ]
      }
    ]
  },
  "global": {
      "anchors": [
        {
          "anchor": "API Playground",
          "href": "https://app.nextevi.com/dashboard/evi-playground",
          "icon": "play"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/nextevi",
          "icon": "github"
        },
        {
          "anchor": "Support",
          "href": "mailto:support@nextevi.com",
          "icon": "envelope"
        }
      ]
    },
  "logo": {
    "light": "/logo/nextevi-logo.png",
    "dark": "/logo/nextevi-logo.png"
  },
  "navbar": {
    "links": [
      {
        "label": "API Status",
        "href": "https://status.nextevi.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://dashboard.nextevi.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/nextevi",
      "github": "https://github.com/nextevi",
      "linkedin": "https://linkedin.com/company/nextevi"
    }
  }
}

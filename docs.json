{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "NextEVI Documentation",
  "colors": {
    "primary": "#d76309",
    "light": "#ea8b39",
    "dark": "#b8520a"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Speech-to-Speech",
        "pages": [
          "speech-to-speech/overview",
          "speech-to-speech/authentication",
          {
            "group": "React SDK",
            "pages": [
              "speech-to-speech/react-sdk/installation",
              "speech-to-speech/react-sdk/hooks"
            ]
          },
          {
            "group": "WebSocket API",
            "pages": [
              "speech-to-speech/websocket-api/connection",
              "speech-to-speech/websocket-api/protocol",
              "speech-to-speech/websocket-api/examples"
            ]
          },
          {
            "group": "LiveKit Integration",
            "pages": [
              "speech-to-speech/livekit-integration/installation",
              "speech-to-speech/livekit-integration/quickstart"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "speech-to-speech/features/emotions",
              "speech-to-speech/features/turn-detection"
            ]
          },
          "speech-to-speech/examples"
        ]
      },
      {
        "group": "API Reference",
        "pages": [
          "api-reference/websocket",
          "api-reference/errors"
        ]
      }
    ]
  },
  "global": {
      "anchors": [
        {
          "anchor": "API Playground",
          "href": "https://app.nextevi.com/dashboard/evi-playground",
          "icon": "play"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/nextevi",
          "icon": "github"
        },
        {
          "anchor": "Support",
          "href": "mailto:support@nextevi.com",
          "icon": "envelope"
        }
      ]
    },
  "logo": {
    "light": "/logo/nextevi-logo.png",
    "dark": "/logo/nextevi-logo.png"
  },
  "navbar": {
    "links": [
      {
        "label": "API Status",
        "href": "https://status.nextevi.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://dashboard.nextevi.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/nextevi",
      "github": "https://github.com/nextevi",
      "linkedin": "https://linkedin.com/company/nextevi"
    }
